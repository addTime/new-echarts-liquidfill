{
  "name": "new-echarts-liquidfill",
  "version": "4.0.0",
  "description": "Unofficial modified version of the ECharts liquid fill extension, compatible with ECharts 5 and 6",
  "keywords": [
    "echarts",
    "echarts-extension",
    "liquidfill",
    "liquid-fill",
    "water-wave",
    "chart",
    "visualization",
    "plugin"
  ],
  "homepage": "https://github.com/addTime/new-echarts-liquidfill#readme",
  "bugs": {
    "url": "https://github.com/addTime/new-echarts-liquidfill/issues"
  },
  "main": "dist/echarts-liquidfill.js",
  "module": "index.js",
  "types": "index.d.ts",
  "unpkg": "dist/echarts-liquidfill.min.js",
  "jsdelivr": "dist/echarts-liquidfill.min.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": {
        "import": "./dist/echarts-liquidfill.esm.mjs",
        "require": "./dist/echarts-liquidfill.js"
      },
      "import": "./index.js",
      "require": "./dist/echarts-liquidfill.js",
      "default": "./index.js"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.js",
    "index.d.ts",
    "NOTICE",
    "NOTICE.zh-CN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode development && webpack --mode production",
    "test": "node scripts/smoke.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "author": {
    "name": "Ovilia",
    "email": "me@zhangwenli.com",
    "url": "http://zhangwenli.com"
  },
  "contributors": [
    {
      "name": "songYalong",
      "email": "yalong229797@163.com",
      "url": "https://github.com/addTime"
    }
  ],
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=16"
  },
  "peerDependencies": {
    "echarts": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addTime/new-echarts-liquidfill.git"
  },
  "devDependencies": {
    "echarts": "^5.2.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  }
}

{
  "name": "echarts-liquidfill",
  "version": "4.0.0",
  "description": "ECharts liquid fill extension",
  "main": "dist/echarts-liquidfill.js",
  "module": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": {
        "import": "./dist/echarts-liquidfill.esm.mjs",
        "require": "./dist/echarts-liquidfill.js"
      },
      "import": "./index.js",
      "require": "./dist/echarts-liquidfill.js",
      "default": "./index.js"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode development && webpack --mode production",
    "prepublishOnly": "npm run build"
  },
  "author": {
    "name": "Ovilia",
    "email": "me@zhangwenli.com",
    "url": "http://zhangwenli.com"
  },
  "license": "MIT",
  "peerDependencies": {
    "echarts": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ecomfe/echarts-liquidfill"
  },
  "devDependencies": {
    "echarts": "^5.2.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  }
}
